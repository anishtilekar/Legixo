# Copy this file to .env and fill in real values. Never commit .env.

# --- Together.ai (LLM + embeddings) ---
TOGETHER_API_KEY=dummy-together-key
TOGETHER_MODEL=openai/gpt-oss-20b
TOGETHER_UTILITY_MODEL=openai/gpt-oss-20b
TOGETHER_EMBED_MODEL=intfloat/multilingual-e5-large-instruct

# --- Pinecone ---
PINECONE_API_KEY=dummy-pinecone-key
PINECONE_INDEX_NAME=legixo-qa
PINECONE_NAMESPACE=legixo-demo
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- App --- 
CORPUS_DIR=corpus
CHUNK_TOKENS=350
CHUNK_OVERLAP_TOKENS=60
TOP_K=5

# --- Retrieval strategy (defaults follow eval/ablation.md measurements) ---
# dense | hybrid   (hybrid also needs: RETRIEVAL_MODE=hybrid python -m scripts.ingest --reset)
RETRIEVAL_MODE=dense
RERANK_ENABLED=false
RERANK_CANDIDATES=15
PINECONE_SPARSE_INDEX_NAME=legixo-qa-sparse
MAX_ATTEMPTS=2
RELEVANCE_FLOOR=0.75
INGEST_TOKEN=dummy-ingest-token

# --- Optional: LangSmith tracing (leave unset to disable) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=legixo-qa-takehome
